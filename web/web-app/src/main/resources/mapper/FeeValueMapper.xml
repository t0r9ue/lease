<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lease.web.app.mapper.FeeValueMapper">
    <resultMap id="BaseResultMap" type="com.lease.model.entity.FeeValue">
        <!--@mbg.generated-->
        <!--@Table fee_value-->
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="name" jdbcType="VARCHAR" property="name"/>
        <result column="unit" jdbcType="VARCHAR" property="unit"/>
        <result column="fee_key_id" jdbcType="BIGINT" property="feeKeyId"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
        <result column="is_deleted" jdbcType="TINYINT" property="isDeleted"/>
    </resultMap>
    <sql id="Base_Column_List">
        <!--@mbg.generated-->
        id,
        `name`,
        unit,
        fee_key_id,
        create_time,
        update_time,
        is_deleted
    </sql>

    <select id="selectByApartmentId" resultType="com.lease.web.app.vo.fee.FeeValueVo">
        SELECT fv.id,
               fv.name,
               fv.unit,
               fv.fee_key_id,
               fk.name fee_key_name
        FROM fee_value fv
                 JOIN fee_key fk
                      ON fv.fee_key_id = fk.id
                 JOIN apartment_fee_value afv
                      ON fv.id = afv.fee_value_id
        WHERE fk.is_deleted = 0
          AND fv.is_deleted = 0
          AND afv.is_deleted = 0
          AND afv.apartment_id = #{apartmentId,jdbcType=BIGINT}
    </select>
</mapper>