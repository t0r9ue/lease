<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lease.web.app.mapper.ApartmentInfoMapper">
    <resultMap id="BaseResultMap" type="com.lease.model.entity.ApartmentInfo">
        <!--@mbg.generated-->
        <!--@Table apartment_info-->
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="name" jdbcType="VARCHAR" property="name"/>
        <result column="introduction" jdbcType="VARCHAR" property="introduction"/>
        <result column="district_id" jdbcType="BIGINT" property="districtId"/>
        <result column="district_name" jdbcType="VARCHAR" property="districtName"/>
        <result column="city_id" jdbcType="BIGINT" property="cityId"/>
        <result column="city_name" jdbcType="VARCHAR" property="cityName"/>
        <result column="province_id" jdbcType="BIGINT" property="provinceId"/>
        <result column="province_name" jdbcType="VARCHAR" property="provinceName"/>
        <result column="address_detail" jdbcType="VARCHAR" property="addressDetail"/>
        <result column="latitude" jdbcType="VARCHAR" property="latitude"/>
        <result column="longitude" jdbcType="VARCHAR" property="longitude"/>
        <result column="phone" jdbcType="VARCHAR" property="phone"/>
        <result column="is_release" jdbcType="TINYINT" property="isRelease"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
        <result column="is_deleted" jdbcType="TINYINT" property="isDeleted"/>
    </resultMap>

    <resultMap id="ApartmentItemMap" type="com.lease.web.app.vo.apartment.ApartmentItemVo" autoMapping="true">
        <id property="id" column="id"/>
        <collection property="graphVoList" ofType="com.lease.web.app.vo.graph.GraphVo" autoMapping="true">
        </collection>
        <collection property="labelInfoList" ofType="com.lease.model.entity.LabelInfo" autoMapping="true">
        </collection>
    </resultMap>

    <sql id="Base_Column_List">
        <!--@mbg.generated-->
        id,
        `name`,
        introduction,
        district_id,
        district_name,
        city_id,
        city_name,
        province_id,
        province_name,
        address_detail,
        latitude,
        longitude,
        phone,
        is_release,
        create_time,
        update_time,
        is_deleted
    </sql>

    <select id="selectApartmentInfoById" resultMap="ApartmentItemMap">
        SELECT ai.id,
               ai.name,
               ai.introduction,
               ai.district_id,
               ai.district_name,
               ai.city_id,
               ai.city_name,
               ai.province_id,
               ai.province_name,
               ai.address_detail,
               ai.latitude,
               ai.longitude,
               ai.phone,
               ai.is_release,
               gi.id,
               gi.name,
               gi.item_type,
               gi.item_id,
               gi.url,
               li.id,
               li.type,
               li.name,
               min(ri.rent)
        FROM apartment_info ai
                 left join graph_info gi
                           ON ai.id = gi.item_id and gi.item_type = 1 and gi.is_deleted = 0
                 left join apartment_label al
                           ON ai.id = al.apartment_id and al.is_deleted = 0
                 join label_info li
                      ON al.label_id = li.id
                 left join room_info ri
                           ON ai.id = ri.apartment_id AND ri.is_deleted = 0 AND ri.is_release = 1
        WHERE ai.is_deleted = 0
          AND ai.is_release = 1
          AND ai.id = #{apartmentId,jdbcType=BIGINT}
          AND li.is_deleted = 0;
    </select>
</mapper>