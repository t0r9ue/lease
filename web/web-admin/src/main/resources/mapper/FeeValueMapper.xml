<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lease.web.admin.mapper.FeeValueMapper">
    <resultMap id="BaseResultMap" type="com.lease.model.entity.FeeValue">
        <!--@mbg.generated-->
        <!--@Table fee_value-->
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="name" jdbcType="VARCHAR" property="name"/>
        <result column="unit" jdbcType="VARCHAR" property="unit"/>
        <result column="fee_key_id" jdbcType="BIGINT" property="feeKeyId"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
        <result column="is_deleted" jdbcType="TINYINT" property="isDeleted"/>
    </resultMap>
    <sql id="Base_Column_List">
        <!--@mbg.generated-->
        id,
        `name`,
        unit,
        fee_key_id,
        create_time,
        update_time,
        is_deleted
    </sql>

    <select id="selectListByApartmentId" resultType="com.lease.web.admin.vo.fee.FeeValueVo">
        SELECT k.name fee_key_name, v.id, v.name, v.unit, v.fee_key_id
        FROM fee_key k
                 join lease.fee_value v on k.id = v.fee_key_id
        WHERE k.is_deleted = 0
          AND v.is_deleted = 0
          AND v.id in (SELECT id
                       FROM apartment_fee_value
                       WHERE apartment_id = #{id} AND is_deleted = 0)
    </select>
</mapper>