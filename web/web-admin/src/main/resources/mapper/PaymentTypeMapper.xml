<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lease.web.admin.mapper.PaymentTypeMapper">
    <resultMap id="BaseResultMap" type="com.lease.model.entity.PaymentType">
        <!--@mbg.generated-->
        <!--@Table payment_type-->
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="name" jdbcType="VARCHAR" property="name"/>
        <result column="pay_month_count" jdbcType="INTEGER" property="payMonthCount"/>
        <result column="additional_info" jdbcType="VARCHAR" property="additionalInfo"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
    </resultMap>
    <sql id="Base_Column_List">
        <!--@mbg.generated-->
        id,
        `name`,
        pay_month_count,
        additional_info,
        create_time,
        update_time,
        is_deleted
    </sql>

    <select id="selectListByRoomId" resultMap="BaseResultMap">
        SELECT DISTINCT pt.id, pt.name, pt.pay_month_count, pt.additional_info
        FROM payment_type pt
                 JOIN room_payment_type rpt
                      ON pt.id = rpt.payment_type_id
        WHERE pt.is_deleted = 0
          AND rpt.is_deleted = 0
          AND rpt.room_id = #{id,jdbcType=BIGINT}
    </select>
</mapper>